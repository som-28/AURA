# Copy to .env and edit
# Local Ollama/Qwen (no API key required)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
LLM_REQUEST_TIMEOUT=120
# Fast, local sentence extraction avoids a second model call; set to llm for model-written summaries.
SUMMARY_MODE=extractive

# Optional hosted provider (set LLM_PROVIDER=openai to use it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-smtp-password-or-app-password
SMTP_FROM=your-verified-sender@gmail.com
# Legacy fallback; SMTP_FROM takes priority.
DEFAULT_FROM=

# Search API (SerpAPI recommended)
SERPAPI_KEY=your-serpapi-key-here
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Planner mode: "rule" or "llm" (uses the provider above)
PLANNER_MODE=llm

# Scraper mode: "requests" or "playwright"
SCRAPER_MODE=requests
