# Copy to .env and edit
# Local Ollama/Qwen (no API key required)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
LLM_REQUEST_TIMEOUT=120
# Fast, local sentence extraction avoids a second model call; set to llm for model-written summaries.
SUMMARY_MODE=extractive

# Optional hosted provider (set LLM_PROVIDER=openai to use it)
# Optional hosted providers (set LLM_PROVIDER=openai or gemini to use one)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Legacy fallback; SMTP_FROM takes priority.
DEFAULT_FROM=

# Search API (SerpAPI recommended)
SERPAPI_KEY=
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Planner mode: "rule" or "llm" (uses the provider above)
PLANNER_MODE=llm

# Scraper mode: "requests" or "playwright"
SCRAPER_MODE=requests

# Optional Neon PostgreSQL persistence. Keep this URL private; never commit it.
# If unset/local, AURA continues using local JSON files.
AURA_STORAGE_BACKEND=local
# Neon CLI provides DATABASE_URL; this explicit variable can override it.
DATABASE_URL=
NEON_DATABASE_URL=
# Until account login is configured, use one private deployment per user.
AURA_USER_ID=single-user
AURA_AUTH_REQUIRED=true
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=http://127.0.0.1:8000,http://localhost:8000
